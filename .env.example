# Evntora - Environment Configuration
# Copy this file to .env.local and replace with your actual keys

# Supabase Configuration (Optional for demo mode; required for live PostgreSQL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# AI Provider Configuration (Future real AI integration e.g. Gemini, Anthropic, OpenAI)
GEMINI_API_KEY=your-gemini-api-key-here

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

