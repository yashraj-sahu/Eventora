# Evntora - Environment Configuration
# Copy this file to .env.local and replace with your actual keys

# Supabase Configuration (Optional for demo mode; required for live PostgreSQL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
# Server-only. Required for owner-managed administrator invitations and the existing trusted webhook operations.
SUPABASE_SERVICE_ROLE_KEY=

# AI Provider Configuration (server-side free tiers only)
GEMINI_API_KEY=your-gemini-api-key-here
GROQ_API_KEY=your-groq-api-key-here
# Optional; overrides are restricted in code to these free-tier model IDs.
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_MODEL=openai/gpt-oss-20b

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only Brevo transactional email for administrator access and invitations
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Evntora

